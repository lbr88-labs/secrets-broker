# Copy to .env and fill in. Never commit the filled .env.
#
# Bitwarden-compatible vault (NodeWarden / Vaultwarden / Bitwarden).
BW_SERVER=https://vault.example.com

# NodeWarden / Bitwarden personal API key (used by `bw login --apikey`).
BW_CLIENTID=user.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required for remote admin access (login page). Pick a strong password.
SECRETS_BROKER_ADMIN_PASSWORD=change-me

# Public URL used in ntfy action buttons and OAuth metadata.
# A hostname other than 127.0.0.1 / ::1 / localhost counts as "behind a proxy"
# and the process will not start without SECRETS_BROKER_ADMIN_PASSWORD.
# https:// also sets the Secure flag on the admin cookie.
BROKER_PUBLIC_URL=https://broker.example.com

# Set when a tunnel (cloudflared, etc.) connects to a loopback bind.
# A non-loopback BROKER_PUBLIC_URL already implies this.
# SECRETS_BROKER_BEHIND_PROXY=1

# Bind address inside the container. Compose publishes 127.0.0.1:8788:8788
# on the host. Do not publish 0.0.0.0:8788.
SECRETS_BROKER_BIND=0.0.0.0

# 32-byte base64 key, or a file outside the data volume (Docker secret).
# While encryption.key stays inside the data directory, data/master-password
# is not used for auto-unlock.
# SECRETS_BROKER_ENCRYPTION_KEY=
# SECRETS_BROKER_KEY_FILE=/run/secrets/broker-key
# Prefer this over a master-password file:
# SECRETS_BROKER_MASTER_PASSWORD=

# OIDC is off when these are unset. Only the bound subject can log in, and
# binding requires an existing admin session.
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://broker.example.com/oidc/callback

# OAuth is off by default. Registration also requires an admin session.
# SECRETS_BROKER_OAUTH=0
# SECRETS_BROKER_OAUTH_REGISTRATION=0

# Optional notification providers (all are optional).
# Private ntfy topic. The token is sent as Authorization: Bearer.
# NTFY_URL=https://ntfy.example.com/secrets-topic
# NTFY_TOKEN=
# GOTIFY_URL=http://gotify:80
# GOTIFY_TOKEN=your-gotify-app-token
# WXPUSH_URL=https://wxpush.example.com
# WXPUSH_TOKEN=your-wxpush-api-token
# Both Telegram ids are required. Messages never change them.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_USER_ID=123456789

# Leave unset. get_secret returns plaintext to the calling model.
# MCP_ALLOW_READ=1
